# ============================================
# Sentinel-MAS: Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ============================================
# IMPORTANT: Never commit your .env file to Git!
# ============================================

# --- LLM Provider ---
# Choose one: "openai", "groq", or "mock"
# "mock" requires no API key and is the default
LLM_PROVIDER=mock

# OpenAI API Key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Name (optional, defaults are provided)
# For OpenAI: gpt-4o-mini (cheapest), gpt-4o, etc.
# For Groq: llama-3.1-8b-instant (free tier), etc.
LLM_MODEL=

# --- Neo4j Database ---
# Default values work with Neo4j Desktop's default setup
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Application Settings ---
# Enable debug logging (true/false)
DEBUG=false

# Log directory (relative to project root)
LOG_DIR=data/logs
