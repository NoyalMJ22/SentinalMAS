# ============================================
# Sentinel-MAS: Git Ignore
# ============================================

# --- Environment & Secrets ---
.env
*.env

# --- Python Virtual Environment ---
venv/
.venv/
env/

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Data (optional: remove if you want to track logs) ---
data/logs/*.json
data/logs/*.csv

# --- Distribution ---
dist/
build/
*.egg-info/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
